{
  "name": "@vtc/cli",
  "version": "0.2.2",
  "private": true,
  "description": "The vtc command: composition root that wires engine, adapters and compiler.",
  "type": "module",
  "exports": {
    ".": {
      "@vtc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:binary": "bun scripts/build-binary.ts"
  },
  "dependencies": {
    "@vtc/shared": "workspace:*",
    "@vtc/engine": "workspace:*",
    "@vtc/adapters": "workspace:*",
    "@vtc/compiler": "workspace:*",
    "zod": "4.6.7"
  },
  "bin": {
    "vtc": "./dist/bin.js"
  },
  "devDependencies": {
    "vitest": "5.0.4"
  }
}
