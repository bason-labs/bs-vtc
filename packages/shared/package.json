{
  "name": "@vtc/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Frozen VTC contracts: Zod schemas, inferred types, JSON Schemas, HostAdapter and Storage interfaces, pure helpers.",
  "type": "module",
  "exports": {
    ".": {
