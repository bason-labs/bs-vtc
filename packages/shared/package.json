    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.4"
  }
}
