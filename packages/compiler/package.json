{
  "name": "@vtc/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "VTC role compiler: neutral roles/ + skills/ + plugins/ sources to the Claude Code and Codex plugins (dist/claude-plugin, dist/codex-plugin).",
  "type": "module",
  "exports": {
    ".": {
      "@vtc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/bin.js --root ../..",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "compile": "node dist/bin.js --root ../.."
  },
  "dependencies": {
    "@vtc/shared": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "smol-toml": "1.8.0",
    "vitest": "5.0.4"
  }
}
