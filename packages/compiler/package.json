{
  "name": "@vtc/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "VTC role compiler: neutral roles/ + skills/ sources to Claude Code and Codex plugin formats.",
  "type": "module",
  "exports": {
    ".": {
      "@vtc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@vtc/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.4"
  }
}
