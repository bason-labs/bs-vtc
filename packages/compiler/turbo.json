{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/roles/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/plugins/**"
      ],
      "outputs": [
        "dist/**",
        "$TURBO_ROOT$/dist/claude-plugin/**",
        "$TURBO_ROOT$/dist/codex-plugin/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/roles/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/plugins/**"
      ]
    }
  }
}
