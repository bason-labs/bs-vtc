{
  "description": "VTC hooks: an extra layer of defence only (spine AD-8 rule 3). The engine and the OS sandbox enforce; `vtc hook` exits 0 when no VTC run is active.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vtc hook session-start --host claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "vtc hook pre-tool-use --host claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vtc hook subagent-stop --host claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
