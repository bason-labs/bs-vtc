{
  "name": "@vtc/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Flow Studio: the read-only local dashboard (spec \u00a717), a Next.js static export served by the vtc binary.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4300",
    "dev:fixtures": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fixture-server.ts",
    "dev:engine": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/engine-proxy.ts",
    "build": "next build && node -e \"require('node:fs').rmSync('next-env.d.ts',{force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts next.config.ts vitest.config.ts postcss.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@vtc/shared": "workspace:*",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
